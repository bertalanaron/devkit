@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Private dependencies (needed at link time for static library)
find_dependency(glad CONFIG)
find_dependency(SDL3 CONFIG)
find_dependency(assimp)
find_dependency(nfd CONFIG)
find_dependency(Boost COMPONENTS dll)
find_dependency(poly2tri)

# Public dependencies that consumers need
find_dependency(imgui CONFIG)
find_dependency(glm CONFIG)
find_dependency(nlohmann_json CONFIG)
find_dependency(spdlog CONFIG)
find_dependency(magic_enum CONFIG)
find_dependency(yaml-cpp)
find_dependency(ftxui CONFIG)
find_dependency(cereal CONFIG)
find_path(MINI_INCLUDE_DIRS "mini/ini.h")

include("${CMAKE_CURRENT_LIST_DIR}/devkit-targets.cmake")
